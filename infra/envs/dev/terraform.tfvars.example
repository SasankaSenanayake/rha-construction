# Copy to terraform.tfvars and fill in real values before `terraform apply`.
# terraform.tfvars is gitignored — never commit it.

aws_region  = "eu-west-1"
name_prefix = "rha-construction-dev"

# --- Replace these placeholders with real business details ---
domain_name     = "example.com"    # e.g. rhaconstruction.lk
manage_dns      = false             # set true once you own domain_name and have its Route53 zone
route53_zone_id = ""                # Route53 hosted zone ID for domain_name, once manage_dns = true

ses_domain       = "example.com"          # domain SES will send from
ses_from_address = "no-reply@example.com" # verified sending address
ses_to_address   = "owner@example.com"    # business owner's receiving address

alert_email      = "owner@example.com"    # budget + CloudWatch alarm notifications
budget_limit_usd = 5

# The prod stack already registered token.actions.githubusercontent.com
# in this account — it's account-wide, so this stays false here.
create_oidc_provider = false

github_org  = "SasankaSenanayake"
github_repo = "rha-construction"

# ARN of the bucket created by `terraform apply` in infra/bootstrap
terraform_state_bucket_arn = "arn:aws:s3:::rha-construction-tfstate-REPLACE_ME"
