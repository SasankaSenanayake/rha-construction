# Copy to .env.local for local dev. All NEXT_PUBLIC_* vars are baked into
# the static export at build time — set real values in CI before `next build`
# once real business details are available.

NEXT_PUBLIC_COMPANY_NAME="R.H.A. Construction (Pvt) Ltd"
NEXT_PUBLIC_DOMAIN="example.com"
NEXT_PUBLIC_PHONE_DISPLAY="+94 77 000 0000"
NEXT_PUBLIC_PHONE_HREF="+94770000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="94770000000"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"
NEXT_PUBLIC_ADDRESS="123 Galle Road, Colombo, Sri Lanka"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_SRC="https://www.google.com/maps/embed?pb=..."

# Base URL of the API Gateway HTTP API (infra/envs/prod output: api_base_url)
NEXT_PUBLIC_API_BASE_URL="https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com"
